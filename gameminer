-- A read-only scrolling text panel, used for every tab except Export.
local function makeReadout(tabPage)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, 0, 1, 0)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.Parent = tabPage
	local pad = Instance.new("UIPadding", scroll)
	pad.PaddingRight = UDim.new(0, 8)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Code
	label.TextSize = 13
	label.TextColor3 = Color3.fromRGB(230, 180, 110)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.TextWrapped = true
	label.Text = ""
	label.Parent = scroll

	return label
end

local remotesLabel = makeReadout(remotesTab)
local statsLabel = makeReadout(statsTab)
local backpackLabel = makeReadout(backpackTab)
local plotLabel = makeReadout(plotTab)

local function refreshAll()
	runScan()
	remotesLabel.Text = remotesText()
	statsLabel.Text = statsText()
	backpackLabel.Text = backpackText()
	plotLabel.Text = plotText()
end
refreshAll()

