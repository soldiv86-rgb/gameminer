--------------------------------------------------------------------
-- Game Data Miner v2
--
-- Drop this into ANY Roblox game (loadstring it like any other script)
-- to automatically discover:
--   1. RemoteEvents/RemoteFunctions, grouped by likely purpose
--      (farming, placing, hatching, feeding, buying, etc.), with REAL
--      observed argument samples when Record Mode is enabled
--   2. Currency/rate/stat value instances (leaderstats, SavedData,
--      Data, PlayerData, Stats, or ANY container as a fallback), across
--      Number/Int/String/Bool/Object/Color3 value types
--   3. Backpack item structure - grouped by base name, INCLUDING the
--      currently equipped tool (which lives on the Character, not the
--      Backpack, while equipped)
--   4. Your owned plot's folders (Pets, Eggs, Nests, ...), detected via
--      ValueObject ownership, Attribute ownership, OR CollectionService
--      tags - so games that don't use the Ride A Pet convention still
--      get picked up
--   5. A diff against the previous scan, so you can tell exactly what a
--      single in-game action (opening a shop, hatching once) revealed
--
-- Point is: run this once on a new game, then hand the exported report
-- back to whoever's wiring up the automation instead of them guessing
-- at names turn by turn.
--------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Reuses the same UI library so this looks and feels like the rest of the
-- script hub tooling instead of a bare console dump.
local UI = loadstring(game:HttpGet("https://raw.githubusercontent.com/soldiv86-rgb/DivineSouls/main/core/ui.lua"))()

--------------------------------------------------------------------
-- GAME IDENTITY
-- game.PlaceId is only one of three IDs worth knowing: PlaceId identifies
-- THIS specific place, GameId (the universe id) is what groups multiple
-- places of the same game together (a lobby + several gameplay places
-- often share one GameId but have different PlaceIds), and neither one is
-- a human-readable name on its own - that needs an actual API call.
-- Fetched once at load time since it can't change mid-session.
--------------------------------------------------------------------
local gameName = "Unknown"
do
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(game.PlaceId, Enum.InfoType.Asset)
	end)
	if ok and info and info.Name then
		gameName = info.Name
	end
end

--------------------------------------------------------------------
-- CATEGORIZATION RULES
-- Edit these lists if a new game uses different naming conventions -
-- everything else in the file just consumes these tables.
--------------------------------------------------------------------
local RemoteCategories = {
	{ name = "Farming / Collecting", keywords = { "collect", "farm", "gather", "pickup", "harvest", "claim" } },
	{ name = "Placement",            keywords = { "place", "spawn", "unplace", "remove" } },
	{ name = "Hatching",             keywords = { "hatch", "unbox", "open", "reveal" } },
	{ name = "Feeding",              keywords = { "feed", "nourish", "eat" } },
	{ name = "Economy",              keywords = { "buy", "purchase", "sell", "autobuy", "shop" } },
	{ name = "Progression",          keywords = { "rebirth", "prestige", "levelup", "upgrade", "ascend", "reset" } },
	{ name = "Movement",             keywords = { "teleport", "warp", "travel" } },
	{ name = "Equip / Inventory",    keywords = { "equip", "unequip", "wear", "inventory" } },
	{ name = "Social",               keywords = { "gift", "invite", "friend", "trade" } },
}

local StatCategories = {
	{ name = "Currency",    keywords = { "cash", "money", "coin", "gold", "gem", "diamond", "token" } },
	{ name = "Income Rate", keywords = { "income", "/s", "persec", "rate", "mps" } },
	{ name = "Progression", keywords = { "level", "rebirth", "prestige", "exp", "xp", "age" } },
	{ name = "Luck",        keywords = { "luck" } },
	{ name = "Weight/Size", keywords = { "kg", "weight", "size", "mass" } },
	{ name = "Flag",        keywords = { "owns", "has", "is", "vip", "unlocked" } },
	{ name = "Time",        keywords = { "playtime", "uptime", "time" } },
}

-- Common root containers stat values tend to live under, across different
-- games' conventions. Add more here if a game uses something unusual.
-- If NONE of these exist (or none contain anything), scanStats() falls
-- back to a full recursive scan of the player instance - see IMPROVEMENT 3.
local StatContainerNames = { "leaderstats", "SavedData", "Data", "PlayerData", "Stats", "Currency" }

-- Common tag names used by CollectionService for plot/base ownership, for
-- games that don't use a Plots/<plot>/Data/Owner folder convention.
local PlotTagNames = { "Plot", "Farm", "Base", "Island", "House" }

-- A StringValue whose content looks like a formatted number ("548.09M",
-- "1.2K", "39", "0") is very likely a currency/stat display value even if
-- its NAME doesn't match a keyword - see IMPROVEMENT 5.
local NUMBER_LIKE_PATTERN = "^%s*%d+%.?%d*[%a]?%s*$"

--------------------------------------------------------------------
-- SCANNERS
--------------------------------------------------------------------
local function categorize(name, categories)
	local lowerName = name:lower()
	for _, cat in ipairs(categories) do
		for _, kw in ipairs(cat.keywords) do
			if lowerName:find(kw, 1, true) then
				return cat.name, kw
			end
		end
	end
	return "Uncategorized", nil
end

--------------------------------------------------------------------
-- IMPROVEMENT 1: LIVE REMOTE RECORDING
-- Instead of only reporting remote NAMES, optionally hook __namecall while
-- you manually interact with the game, and correlate real FireServer /
-- InvokeServer calls with the remotes already found by scanRemotes().
-- The exported report then shows a real observed argument sample next to
-- any remote you triggered while recording, instead of a blind guess.
--------------------------------------------------------------------
local recordEnabled = false
local recordedSamples = {} -- [fullPath] = { argsText = "...", count = n, lastSeen = os.time() }
local recordSupported = (hookmetamethod ~= nil) and (getnamecallmethod ~= nil)
local originalNamecall

-- Live scrolling log, shared by both the outgoing hook below (__namecall,
-- needs hookmetamethod) and the incoming OnClientEvent hooks further down
-- (which need nothing executor-specific - they're just normal signals).
-- A ring buffer rather than an ever-growing table so a chatty game doesn't
-- slowly balloon memory over a long session.
local liveLogEnabled = true
local liveLogLines = {}
local MAX_LOG_LINES = 300
local liveLogFilter = ""
local incomingLogEnabled = false

local function pushLog(line)
	if not liveLogEnabled then return end
	table.insert(liveLogLines, line)
	if #liveLogLines > MAX_LOG_LINES then
		table.remove(liveLogLines, 1)
	end
end

local function formatArgs(args, argCount)
	local parts = {}
	for i = 1, argCount do
		local v = args[i]
		if typeof(v) == "Instance" then
			table.insert(parts, v:GetFullName())
		elseif typeof(v) == "table" then
			table.insert(parts, "{table}")
		else
			table.insert(parts, tostring(v))
		end
	end
	return table.concat(parts, ", ")
end

if recordSupported then
	originalNamecall = hookmetamethod(game, "__namecall", function(self, ...)
		-- Capture varargs + count HERE, in the outer vararg function - '...'
		-- cannot be read from a nested pcall(function() ... end) below.
		local args = { ... }
		local argCount = select("#", ...)
		local method = getnamecallmethod()

		if recordEnabled and (method == "FireServer" or method == "InvokeServer")
			and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
			local ok, text = pcall(formatArgs, args, argCount)
			local path = self:GetFullName()
			local existing = recordedSamples[path]
			recordedSamples[path] = {
				argsText = ok and text or "?",
				count = (existing and existing.count or 0) + 1,
				lastSeen = os.time(),
			}
		end

		return originalNamecall(self, ...)
	end)
end

--------------------------------------------------------------------
-- IMPROVEMENT 1b: STATIC REMOTE USAGE SCAN (no in-game interaction needed)
-- If you can't manually trigger a remote to have Record Mode capture it,
-- this instead decompiles the game's own LocalScripts/ModuleScripts and
-- searches their source for "<RemoteName>...:FireServer(...)" / InvokeServer
-- patterns, pulling the REAL argument expression straight out of the
-- game's own code - no clicking required.
--
-- Requires the executor to expose a decompile() function. Not every
-- executor supports this - if it's missing, the UI says so plainly instead
-- of silently doing nothing. Even when it works, this is best-effort: some
-- remotes are only ever fired from server-side scripts you can't read, or
-- from a script that hasn't loaded yet, and those simply won't show a
-- static reference - that's not a bug, there's nothing on the client to
-- find for them.
--------------------------------------------------------------------
local decompileAvailable = typeof(decompile) == "function"
local staticSamples = {} -- [fullPath] = { entries = { {argsText=..., scriptName=...}, ... } }
local staticScanRan = false
local MAX_SCRIPTS_TO_SCAN = 400
local MAX_ENTRIES_PER_REMOTE = 3

local function findAllScripts()
	local list, listedAlready = {}, {}

	-- Some executors expose getscripts() which can surface loaded scripts
	-- that GetDescendants() alone might miss.
	if typeof(getscripts) == "function" then
		local ok, res = pcall(getscripts)
		if ok and type(res) == "table" then
			for _, s in ipairs(res) do
				if (s:IsA("LocalScript") or s:IsA("ModuleScript")) and not listedAlready[s] then
					listedAlready[s] = true
					table.insert(list, s)
				end
			end
		end
	end

	if #list == 0 then
		for _, inst in ipairs(game:GetDescendants()) do
			if (inst:IsA("LocalScript") or inst:IsA("ModuleScript")) and not listedAlready[inst] then
				listedAlready[inst] = true
				table.insert(list, inst)
			end
		end
	end

	return list
end

-- Walks forward from an opening '(' and returns everything up to its
-- matching ')', so nested calls/tables inside the argument list don't
-- confuse a naive "find the next )" approach.
local function extractCallArgs(source, openParenPos)
	local depth = 0
	local len = #source
	local startArgs = openParenPos + 1
	local i = openParenPos
	while i <= len do
		local c = source:sub(i, i)
		if c == "(" then
			depth += 1
		elseif c == ")" then
			depth -= 1
			if depth == 0 then
				return source:sub(startArgs, i - 1)
			end
		end
		i += 1
	end
	return nil
end

-- Given the full decompiled corpus and the position where a remote's NAME
-- was found, looks a short distance ahead for ":FireServer(" or
-- ":InvokeServer(" and extracts the literal argument text between the
-- parens if found nearby.
local function findNearbyCall(corpus, nameEndPos)
	local windowEnd = math.min(#corpus, nameEndPos + 150)
	local window = corpus:sub(nameEndPos, windowEnd)
	local relPos = window:find(":%s*FireServer%s*%(") or window:find(":%s*InvokeServer%s*%(")
	if not relPos then return nil end
	local parenRel = window:find("%(", relPos)
	if not parenRel then return nil end
	local parenPos = nameEndPos + parenRel - 1
	return extractCallArgs(corpus, parenPos)
end

-- Escapes Lua pattern-magic characters in a string so it can be safely
-- dropped into a pattern (e.g. a local variable name that happens to
-- contain "." from a reassignment like "self.Remote").
local function escapePattern(s)
	return (s:gsub("([%.%%%+%-%*%?%[%]%^%$%(%)])", "%%%1"))
end

-- Runs the full static scan across up to MAX_SCRIPTS_TO_SCAN scripts.
-- Two passes per script:
--   A) DIRECT calls - "SomeFolder.Bar:FireServer(...)" where the remote's
--      own name sits right before the call. Rare in practice, but cheap
--      to check.
--   B) INDIRECT calls via a cached local variable - by far the more common
--      real-world pattern:
--          local Bar = ReplicatedStorage.Foo.Bar
--          ...
--          Bar:FireServer(x, y)
--      Pass B scans each line for an assignment whose right-hand side
--      mentions the remote's name, records that line's variable as an
--      alias, then searches the WHOLE script (not just nearby) for
--      "<alias>:FireServer(" / "InvokeServer(" and extracts the real args.
-- Also tracks how many scripts actually decompiled to something usable,
-- since decompile() can exist as a function yet still fail per-script
-- (obfuscation/protection) - that's a different failure mode than "the
-- search logic didn't find a match", and worth telling apart when the
-- result is a flat 0.
local function runStaticScan(knownRemotes, progressCallback)
	if not decompileAvailable then
		return false, "decompile() isn't available in this executor - static scan can't run here."
	end

	local scripts = findAllScripts()
	if #scripts > MAX_SCRIPTS_TO_SCAN then
		local trimmed = {}
		for i = 1, MAX_SCRIPTS_TO_SCAN do trimmed[i] = scripts[i] end
		scripts = trimmed
	end

	-- PASS 0: decompile everything once and keep the source around (Pass B
	-- needs to re-scan the full script, not just a small window).
	local srcByScript = {}
	local decompiledCount = 0
	for idx, s in ipairs(scripts) do
		local ok, src = pcall(decompile, s)
		if ok and type(src) == "string" and #src > 20 then
			srcByScript[s:GetFullName()] = src
			decompiledCount += 1
		end
		if idx % 15 == 0 then
			task.wait()
			if progressCallback then progressCallback(idx, #scripts) end
		end
	end

	if decompiledCount == 0 then
		staticScanRan = true
		return false, string.format(
			"decompile() exists but returned nothing usable for any of the %d scripts checked - it's likely blocked/non-functional here, not a search-logic issue. Record Mode (manual trigger) is your fallback.",
			#scripts
		)
	end

	-- Build shortName -> remotePaths once instead of recomputing per script.
	local shortNameToRemotes = {}
	for _, r in ipairs(knownRemotes) do
		local shortName = r.path:match("[^%.]+$") or r.path
		if #shortName >= 3 then -- skip absurdly short/common names that would false-positive everywhere
			shortNameToRemotes[shortName] = shortNameToRemotes[shortName] or {}
			table.insert(shortNameToRemotes[shortName], r.path)
		end
	end

	staticSamples = {}
	local function recordSample(remotePath, argsText, scriptName)
		local bucket = staticSamples[remotePath]
		if not bucket then
			bucket = { entries = {} }
			staticSamples[remotePath] = bucket
		end
		if #bucket.entries >= MAX_ENTRIES_PER_REMOTE then return end
		for _, e in ipairs(bucket.entries) do
			if e.argsText == argsText then return end -- de-dupe identical hits
		end
		table.insert(bucket.entries, { argsText = argsText, scriptName = scriptName })
	end

	local processed = 0
	for scriptName, src in pairs(srcByScript) do
		processed += 1

		-- PASS A: direct calls.
		for shortName, remotePaths in pairs(shortNameToRemotes) do
			local searchFrom = 1
			while true do
				local s, e = src:find(shortName, searchFrom, true)
				if not s then break end
				local argsText = findNearbyCall(src, e + 1)
				if argsText then
					for _, remotePath in ipairs(remotePaths) do
						recordSample(remotePath, argsText, scriptName)
					end
				end
				searchFrom = e + 1
			end
		end

		-- PASS B: indirect calls via a cached local variable - the pattern
		-- almost all real game scripts actually use.
		for line in src:gmatch("[^\n]+") do
			local varName, rhs = line:match("^%s*local%s+([%w_]+)%s*=%s*(.+)$")
			if not varName then
				varName, rhs = line:match("([%w_%.]+)%s*=%s*(.+)$")
			end
			if varName and rhs then
				for shortName, remotePaths in pairs(shortNameToRemotes) do
					if rhs:find(shortName, 1, true) then
						local escapedVar = escapePattern(varName)
						local callPos = src:find(escapedVar .. "%s*:%s*FireServer%s*%(")
							or src:find(escapedVar .. "%s*:%s*InvokeServer%s*%(")
						if callPos then
							local parenPos = src:find("%(", callPos)
							local argsText = parenPos and extractCallArgs(src, parenPos)
							if argsText then
								for _, remotePath in ipairs(remotePaths) do
									recordSample(remotePath, argsText, scriptName .. " (via local " .. varName .. ")")
								end
							end
						end
					end
				end
			end
		end

		if processed % 10 == 0 then task.wait() end
	end

	staticScanRan = true
	local foundCount = 0
	for _ in pairs(staticSamples) do foundCount += 1 end

	if foundCount == 0 then
		return true, string.format(
			"Decompiled %d/%d scripts successfully, but found no FireServer/InvokeServer references to any of the %d known remotes - directly OR via a cached local variable. This game's client code likely dispatches remotes through a shared wrapper/queue function instead of calling them inline, which static text search can't see through. Record Mode (manual trigger) is the reliable option for this game.",
			decompiledCount, #scripts, #knownRemotes
		)
	end

	return true, string.format(
		"Decompiled %d/%d scripts. Found static references for %d/%d remotes.",
		decompiledCount, #scripts, foundCount, #knownRemotes
	)
end

local function scanRemotes()
	local results = {}
	for _, inst in ipairs(ReplicatedStorage:GetDescendants()) do
		if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
			local category = categorize(inst.Name, RemoteCategories)
			local fullPath = inst:GetFullName()
			table.insert(results, {
				path = fullPath,
				className = inst.ClassName,
				category = category,
				sample = recordedSamples[fullPath],
				static = staticSamples[fullPath],
			})
		end
	end
	return results
end

--------------------------------------------------------------------
-- IMPROVEMENT 3 & 4 & 5: BROADER STAT SCANNING
-- - Falls back to a full recursive scan of the player instance if none of
--   the named containers exist or contain anything (IMPROVEMENT 3).
-- - Recognizes Bool/Object/Color3 values in addition to Number/Int/String
--   (IMPROVEMENT 4).
-- - Flags StringValues whose CONTENT looks like a formatted number as
--   high-confidence Currency even if the name doesn't match a keyword,
--   since many games (like Campfire) pre-format "548.09M" style strings
--   (IMPROVEMENT 5).
--------------------------------------------------------------------
local VALUE_CLASSES = {
	NumberValue = true, IntValue = true, StringValue = true,
	BoolValue = true, ObjectValue = true, Color3Value = true,
}

local function classifyValue(child)
	local category, kw = categorize(child.Name, StatCategories)
	if category == "Uncategorized" and child:IsA("StringValue") then
		local val = child.Value
		if type(val) == "string" and val:match(NUMBER_LIKE_PATTERN) then
			category = "Currency"
			kw = "(content looks numeric)"
		end
	end
	return category, kw
end

local function scanStats()
	local results = {}
	local seen = {}

	local function walk(container, prefix)
		for _, child in ipairs(container:GetChildren()) do
			if VALUE_CLASSES[child.ClassName] then
				local path = prefix .. "." .. child.Name
				if not seen[path] then
					seen[path] = true
					local category = classifyValue(child)
					table.insert(results, {
						path = path,
						className = child.ClassName,
						value = child.Value,
						category = category,
					})
				end
			elseif child:IsA("Folder") or child:IsA("Configuration") then
				walk(child, prefix .. "." .. child.Name)
			end
		end
	end

	for _, containerName in ipairs(StatContainerNames) do
		local container = player:FindFirstChild(containerName)
		if container then
			walk(container, "player." .. containerName)
		end
	end

	-- IMPROVEMENT 3: fallback full scan if the named containers turned up
	-- nothing. Recurses through all of `player`, so it will pick up stats
	-- stored under an unrecognized container name.
	if #results == 0 then
		for _, inst in ipairs(player:GetDescendants()) do
			if VALUE_CLASSES[inst.ClassName] then
				local path = inst:GetFullName()
				if not seen[path] then
					seen[path] = true
					local category = classifyValue(inst)
					table.insert(results, {
						path = path,
						className = inst.ClassName,
						value = inst.Value,
						category = category,
						fallback = true,
					})
				end
			end
		end
	end

	return results
end

-- Groups backpack tools by a "base name" with any trailing "[...]" bracket
-- or trailing number stripped off, so e.g. "Golden Egg [45,231 KG]" x3 and
-- "Golden Egg [12,004 KG]" x1 both roll up under "Golden Egg" with a count
-- and one sample name/attribute set, instead of listing every tool.
--
-- IMPROVEMENT 6: also scans player.Character, since the currently equipped
-- tool moves OUT of Backpack and into Character while it's held - without
-- this, whatever's equipped at scan time silently vanishes from the report.
local function scanBackpack()
	local groups = {}

	local function addTool(tool)
		local baseName = tool.Name:gsub("%s*%[.-%]%s*$", ""):gsub("%s*%d+$", "")
		if baseName == "" then baseName = tool.Name end

		if not groups[baseName] then
			groups[baseName] = { count = 0, sampleName = tool.Name, attributes = tool:GetAttributes() }
		end
		groups[baseName].count += 1
	end

	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") then addTool(tool) end
		end
	end

	local char = player.Character
	if char then
		for _, tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool") then addTool(tool) end
		end
	end

	return groups
end

--------------------------------------------------------------------
-- IMPROVEMENT 2: BROADER PLOT/OWNERSHIP DETECTION
-- Tries, in order:
--   a) the original Plots/<plot>/Data/Owner ValueObject pattern
--   b) Attribute-based ownership (Owner / OwnerId set directly on the plot)
--   c) CollectionService tags (Plot/Farm/Base/Island/House), matched via
--      an Owner/OwnerId attribute or child ValueObject on the tagged
--      instance itself
-- This means games that don't follow Ride A Pet's exact folder convention
-- still get a plot detected instead of silently reporting nothing.
--------------------------------------------------------------------
local function ownerMatches(value)
	if value == nil then return false end
	if typeof(value) == "Instance" then return value == player end
	if typeof(value) == "string" then return value == player.Name end
	if typeof(value) == "number" then return value == player.UserId end
	return false
end

local function isOwnedBy(inst)
	-- (a) Data/Owner ValueObject, or Data/OwnerId
	local data = inst:FindFirstChild("Data")
	if data then
		local ownerValue = data:FindFirstChild("Owner") or data:FindFirstChild("OwnerId")
		if ownerValue and ownerMatches(ownerValue.Value) then return true end
	end

	-- (b) Attributes directly on the instance
	local attrOwner = inst:GetAttribute("Owner") or inst:GetAttribute("OwnerId")
	if ownerMatches(attrOwner) then return true end

	return false
end

local function findOwnedPlot()
	-- Try the classic Plots container first.
	local plots = workspace:FindFirstChild("Plots")
	if plots then
		for _, plot in ipairs(plots:GetChildren()) do
			if isOwnedBy(plot) then return plot end
		end
	end

	-- (c) Fall back to CollectionService tags across the whole workspace.
	for _, tagName in ipairs(PlotTagNames) do
		for _, inst in ipairs(CollectionService:GetTagged(tagName)) do
			if isOwnedBy(inst) then return inst end
		end
	end

	return nil
end

local function scanPlot()
	local plot = findOwnedPlot()
	if not plot then return nil, {} end

	local folders = {}
	for _, child in ipairs(plot:GetChildren()) do
		if child:IsA("Folder") or child:IsA("Model") then
			local children = child:GetChildren()
			local sampleAttributes = children[1] and children[1]:GetAttributes() or nil
			table.insert(folders, {
				name = child.Name,
				className = child.ClassName,
				childCount = #children,
				sampleAttributes = sampleAttributes,
			})
		end
	end
	return plot.Name, folders
end

--------------------------------------------------------------------
-- IMPROVEMENT 7: SCAN DIFFING
-- Keeps a snapshot of remote paths / stat paths / backpack base names from
-- the previous scan, so "Rescan Everything" can report exactly what's NEW
-- since last time - lets you isolate which in-game action revealed which
-- remote/stat instead of eyeballing two full reports.
--------------------------------------------------------------------
local previousSnapshot = nil -- { remotes = {[path]=true}, stats = {[path]=true}, backpack = {[name]=true} }

local function buildSnapshot(remotes, stats, backpackGroups)
	local snap = { remotes = {}, stats = {}, backpack = {} }
	for _, r in ipairs(remotes) do snap.remotes[r.path] = true end
	for _, s in ipairs(stats) do snap.stats[s.path] = true end
	for name in pairs(backpackGroups) do snap.backpack[name] = true end
	return snap
end

local function diffSets(oldSet, newSet)
	local added = {}
	for key in pairs(newSet) do
		if not oldSet[key] then table.insert(added, key) end
	end
	table.sort(added)
	return added
end

local function diffText(remotes, stats, backpackGroups)
	if not previousSnapshot then
		return "DIFF vs PREVIOUS SCAN\n  (this is the first scan - nothing to compare against yet)"
	end

	local newSnap = buildSnapshot(remotes, stats, backpackGroups)
	local newRemotes = diffSets(previousSnapshot.remotes, newSnap.remotes)
	local newStats = diffSets(previousSnapshot.stats, newSnap.stats)
	local newItems = diffSets(previousSnapshot.backpack, newSnap.backpack)

	local lines = {}
	if #newRemotes == 0 and #newStats == 0 and #newItems == 0 then
		table.insert(lines, "  (nothing new since the last scan)")
	else
		if #newRemotes > 0 then
			table.insert(lines, "  New remotes:")
			for _, p in ipairs(newRemotes) do table.insert(lines, "    " .. p) end
		end
		if #newStats > 0 then
			table.insert(lines, "  New stats:")
			for _, p in ipairs(newStats) do table.insert(lines, "    " .. p) end
		end
		if #newItems > 0 then
			table.insert(lines, "  New backpack items:")
			for _, n in ipairs(newItems) do table.insert(lines, "    " .. n) end
		end
	end

	return "DIFF vs PREVIOUS SCAN\n" .. table.concat(lines, "\n")
end

--------------------------------------------------------------------
-- REPORT BUILDING
--------------------------------------------------------------------
local remotes, stats, backpackGroups, plotName, plotFolders = {}, {}, {}, nil, {}
local lastDiffText = ""

local function runScan()
	local newRemotes = scanRemotes()
	local newStats = scanStats()
	local newBackpack = scanBackpack()
	local newPlotName, newPlotFolders = scanPlot()

	-- Compute the diff against whatever the PREVIOUS scan looked like,
	-- before overwriting it with this scan's results.
	lastDiffText = diffText(newRemotes, newStats, newBackpack)
	previousSnapshot = buildSnapshot(newRemotes, newStats, newBackpack)

	remotes, stats, backpackGroups, plotName, plotFolders =
		newRemotes, newStats, newBackpack, newPlotName, newPlotFolders
end

local function buildSection(title, lines)
	if #lines == 0 then
		return title .. "\n  (nothing found)"
	end
	return title .. "\n" .. table.concat(lines, "\n")
end

local function remotesText()
	local byCategory = {}
	local order = {}
	for _, r in ipairs(remotes) do
		if not byCategory[r.category] then
			byCategory[r.category] = {}
			table.insert(order, r.category)
		end
		table.insert(byCategory[r.category], r)
	end

	local lines = {}
	for _, category in ipairs(order) do
		table.insert(lines, "[" .. category .. "]")
		for _, r in ipairs(byCategory[category]) do
			table.insert(lines, "  " .. r.className .. "  " .. r.path)
			if r.sample then
				table.insert(lines, string.format(
					"      observed args (x%d, live): %s",
					r.sample.count,
					(r.sample.argsText == "" and "(none)" or r.sample.argsText)
				))
			end
			if r.static then
				for _, entry in ipairs(r.static.entries) do
					table.insert(lines, string.format(
						"      static ref (from %s): %s",
						entry.scriptName,
						(entry.argsText == "" and "(none)" or entry.argsText)
					))
				end
			end
		end
	end

	local header = string.format("REMOTES  (%d found)", #remotes)
	local hints = {}
	if not recordSupported then
		table.insert(hints, "Record Mode unsupported in this executor")
	elseif not recordEnabled then
		table.insert(hints, "enable Record Mode + trigger actions in-game for live samples")
	end
	if not decompileAvailable then
		table.insert(hints, "static scan unsupported in this executor")
	elseif not staticScanRan then
		table.insert(hints, "run Static Scan in Live Spy tab for no-interaction samples")
	end
	if #hints > 0 then
		header = header .. "  [" .. table.concat(hints, "; ") .. "]"
	end
	return buildSection(header, lines)
end

local function statsText()
	local lines = {}
	for _, s in ipairs(stats) do
		local tag = s.fallback and " (fallback scan)" or ""
		table.insert(lines, string.format("  [%s] %s = %s%s", s.category, s.path, tostring(s.value), tag))
	end

	local suggestions = {}
	for _, s in ipairs(stats) do
		if s.category == "Currency" or s.category == "Income Rate" then
			table.insert(suggestions, "  -> " .. s.path)
		end
	end
	if #suggestions > 0 then
		table.insert(lines, "")
		table.insert(lines, "Suggested webhook fields (verify these are the right ones in-game):")
		for _, s in ipairs(suggestions) do table.insert(lines, s) end
	end

	return buildSection(string.format("STATS / CURRENCY  (%d found)", #stats), lines)
end

local function backpackText()
	local lines = {}
	local count = 0
	for baseName, info in pairs(backpackGroups) do
		count += 1
		table.insert(lines, string.format("%s  x%d  (sample: \"%s\")", baseName, info.count, info.sampleName))
		for attrName, attrValue in pairs(info.attributes) do
			table.insert(lines, "    attribute " .. attrName .. " = " .. tostring(attrValue))
		end
	end
	return buildSection(string.format("BACKPACK ITEMS  (%d distinct, includes equipped)", count), lines)
end

local function plotText()
	local lines = {}
	if plotName then
		table.insert(lines, "Owned plot/base: " .. plotName)
		for _, f in ipairs(plotFolders) do
			table.insert(lines, string.format("  %s (%s, %d children)", f.name, f.className, f.childCount))
			if f.sampleAttributes then
				for k, v in pairs(f.sampleAttributes) do
					table.insert(lines, "      sample attribute " .. k .. " = " .. tostring(v))
				end
			end
		end
	else
		table.insert(lines, "Could not find an owned plot via Plots/Data/Owner, Attributes, or CollectionService tags (" ..
			table.concat(PlotTagNames, ", ") .. "). This game may use a different ownership convention entirely - adjust findOwnedPlot().")
	end
	return buildSection("OWNED PLOT / BASE", lines)
end

--------------------------------------------------------------------
-- IMPROVEMENT 8: AUTOMATION SUGGESTIONS
-- Turns the same category data already computed for the Remotes/Stats
-- tabs into a plain-English "what would you actually automate here"
-- section, instead of leaving that translation step to whoever reads the
-- raw report. These are NAME-based heuristics only - they don't verify
-- real behavior, and say so explicitly in the output so they don't get
-- mistaken for confirmed facts.
--------------------------------------------------------------------
local RemoteSuggestions = {
	["Farming / Collecting"] = "Good auto-farm/auto-collect target. Likely fires with the item instance (egg/resource) being collected.",
	["Placement"]            = "Good auto-place target. Likely fires with the item (Tool or id) being placed.",
	["Hatching"]              = "Good auto-hatch target. Likely fires with the placed item instance once it's ready.",
	["Feeding"]               = "Good auto-feed target. Likely fires with (target instance, food item) as two arguments.",
	["Movement"]              = "Teleport/warp target. Likely needs a destination id, zone number, or position as an argument.",
	["Equip / Inventory"]     = "Equip/unequip target. Likely fires with the item to equip as an argument.",
	["Social"]                = "Social action (gift/trade/invite). Usually not worth automating - low value, and can draw unwanted attention.",
}

-- Economy needs a second look at the name itself: "buy" and "sell" both
-- match the same category, but they're opposite actions with different
-- automation shapes.
local function economySuggestion(remotePath)
	local lower = remotePath:lower()
	if lower:find("sell", 1, true) then
		return "Possible auto-sell target. Verify what it expects (an item id, 'all', a quantity) before automating."
	end
	return "Good auto-buy target. Almost certainly needs an id/name argument (which upgrade/item) - "
		.. "confirm with Record Mode or Static Scan before automating blind."
end

-- Progression (rebirth/prestige/reset) gets its own function rather than a
-- static string so this is the one place a future edit needs to touch if
-- the warning wording ever needs to change.
local function progressionSuggestion()
	return "Prestige/reset-style action - this likely WIPES currency or progress. "
		.. "Only automate behind an explicit stat threshold you choose; never fire this unconditionally."
end

local function remoteSuggestion(r)
	if r.category == "Economy" then return economySuggestion(r.path) end
	if r.category == "Progression" then return progressionSuggestion() end
	return RemoteSuggestions[r.category]
end

local StatSuggestions = {
	["Currency"]    = "Good dashboard/webhook field.",
	["Income Rate"] = "Good dashboard/webhook field; also a natural 'which item is best' comparison metric.",
	["Progression"] = "Good dashboard field, and a natural trigger stat for threshold-based prestige automation.",
	["Weight/Size"] = "Good filter criterion for auto-place logic (e.g. \"only place if >= X KG\").",
	["Luck"]        = "Good webhook field for hatch/reward-result reporting.",
	["Flag"]        = "Good gate condition - check this before running other automation (e.g. only auto-buy if an 'unlocked' flag is true).",
	["Time"]        = "Good dashboard field; not typically useful as an automation trigger.",
}

local function suggestionsText()
	local lines = {}

	table.insert(lines, "Remote suggestions:")
	local anyRemote = false
	for _, r in ipairs(remotes) do
		local suggestion = remoteSuggestion(r)
		if suggestion then
			anyRemote = true
			table.insert(lines, "  " .. r.path)
			table.insert(lines, "    -> " .. suggestion)
		end
	end
	if not anyRemote then
		table.insert(lines, "  (nothing categorized confidently enough to suggest - check the Remotes tab manually)")
	end

	table.insert(lines, "")
	table.insert(lines, "Stat suggestions:")
	local anyStat = false
	for _, s in ipairs(stats) do
		local suggestion = StatSuggestions[s.category]
		if suggestion then
			anyStat = true
			table.insert(lines, "  " .. s.path .. " (" .. s.category .. ")")
			table.insert(lines, "    -> " .. suggestion)
		end
	end
	if not anyStat then
		table.insert(lines, "  (nothing categorized confidently enough to suggest - check the Stats tab manually)")
	end

	table.insert(lines, "")
	table.insert(lines, "These are NAME-based heuristics, not verified behavior. Always confirm the real")
	table.insert(lines, "argument signature (Record Mode or Static Scan) before wiring blind automation -")
	table.insert(lines, "especially anything flagged under Progression, since those likely reset progress.")

	return buildSection("SUGGESTED AUTOMATION", lines)
end

local function fullReport()
	return table.concat({
		"========================================",
		"GAME DATA MINER REPORT",
		"Game: " .. gameName,
		"Universe (GameId): " .. tostring(game.GameId),
		"PlaceId: " .. tostring(game.PlaceId),
		"Player: " .. player.Name,
		"========================================",
		"",
		remotesText(),
		"",
		statsText(),
		"",
		backpackText(),
		"",
		plotText(),
		"",
		suggestionsText(),
		"",
		lastDiffText,
	}, "\n")
end

